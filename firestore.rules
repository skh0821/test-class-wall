rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // test-class-wall 컬렉션 보안 규칙
    match /test-class-wall/{docId} {
      // 1) 비로그인 읽기 거부 (로그인 사용자만 읽기 허용)
      allow read: if request.auth != null;

      // 2) 비로그인 작성 거부, uid 필드 허용, 다른 사람 uid 도용 거부
      //    - text: 5글자 이상 문자열
      //    - createdAt: 밀리초 숫자 (Date.now())
      //    - uid: 로그인한 사용자 본인의 uid와 반드시 일치
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['text', 'createdAt', 'uid'])
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'uid', 'author', 'role'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.createdAt is number
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;

      // 3) 수정 거부
      allow update: if false;

      // 4) 비로그인 삭제 거부, 본인 작성 메모만 삭제 허용 (타인 메모 삭제 불가)
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // memos 컬렉션 (기존 컬렉션 호환용)
    match /memos/{memoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['text', 'createdAt', 'uid'])
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'uid', 'author', 'role'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.createdAt is number
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
